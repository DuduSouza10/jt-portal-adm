// Schema do JT Portal ADM.
// Datas sempre gravadas em UTC; a exibição converte para America/Sao_Paulo.
//
// Este arquivo tem duas partes:
//   1. NÚCLEO (Diogo): acesso, estrutura organizacional e auditoria. Todos os módulos dependem dele.
//   2. MÓDULOS: cada módulo adiciona os seus models em uma seção própria, abaixo do núcleo.
// Regra: um módulo pode referenciar o núcleo (User, Base, Regional), mas não os models de outro módulo
// sem combinar antes. Ver docs/arquitetura.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// NÚCLEO — Estrutura organizacional
// ===========================================================================

/// Regional da J&T (ex.: MG, SPN). Agrupa bases.
model Regional {
  id        String   @id @default(cuid())
  code      String   @unique // sigla, sempre maiúscula
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bases Base[]
  users UserRegional[]
}

enum BaseType {
  BASE // base própria
  FRANQUIA
  ALMOXARIFADO // centro que guarda estoque e envia para as bases
}

/// Base, franquia ou almoxarifado. Sempre pertence a uma regional.
model Base {
  id         String   @id @default(cuid())
  code       String   @unique // sigla, sempre maiúscula
  name       String
  type       BaseType @default(BASE)
  regionalId String
  cnpj       String?
  city       String?
  state      String? // UF
  address    String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  regional Regional   @relation(fields: [regionalId], references: [id])
  users    UserBase[]

  // módulo estoque
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]

  @@index([regionalId])
  @@index([type, active])
}

// ===========================================================================
// NÚCLEO — Usuários, perfis de acesso e sessões
// ===========================================================================

/// Até onde o usuário enxerga dados das bases.
enum AccessScope {
  GLOBAL // todas as bases
  REGIONAL // bases das regionais vinculadas ao usuário
  BASE // só as bases vinculadas ao usuário
}

/// Tipo de acesso (perfil). Define as permissões e o alcance dos dados.
/// Perfis "system" vêm do seed e não podem ser excluídos.
model AccessProfile {
  id          String      @id @default(cuid())
  key         String      @unique // ex.: "admin", "base", "franquia"
  name        String
  description String?
  scope       AccessScope @default(BASE)
  /// Chaves de permissão (ver src/lib/permissions/catalog.ts). "*" = todas.
  permissions String[]
  system      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users User[]
}

model User {
  id                 String    @id @default(cuid())
  name               String
  login              String    @unique // usuário, sempre minúsculo
  email              String?   @unique
  phone              String?
  passwordHash       String?
  profileId          String
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile   AccessProfile  @relation(fields: [profileId], references: [id])
  bases     UserBase[]
  regionals UserRegional[]
  sessions  Session[]
  auditLogs AuditLog[]

  // módulo estoque
  stockMovements StockMovement[]

  @@index([profileId])
  @@index([active, name])
}

model UserBase {
  userId String
  baseId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  base   Base   @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@id([userId, baseId])
  @@index([baseId])
}

model UserRegional {
  userId     String
  regionalId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  regional   Regional @relation(fields: [regionalId], references: [id], onDelete: Cascade)

  @@id([userId, regionalId])
  @@index([regionalId])
}

/// Sessões no banco (não JWT): desativar um usuário derruba as sessões na hora.
model Session {
  id        String   @id // sha256 do token do cookie
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  login     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([login, createdAt])
  @@index([ip, createdAt])
}

// ===========================================================================
// NÚCLEO — Auditoria
// ===========================================================================

/// Registro de toda alteração relevante. Gravado por src/lib/audit.ts — nunca editado nem apagado.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String? // null = sistema (jobs, seed)
  action    String // ex.: "usuario.criar", "base.editar"
  entity    String // ex.: "User", "Base"
  entityId  String?
  summary   String // frase legível: "Criou a base BHZ01"
  data      Json? // antes/depois ou detalhes
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// ===========================================================================
// MÓDULOS — cada um adiciona sua seção aqui embaixo
// ===========================================================================
// Ex.: // ---- MÓDULO: solicitacoes (Eduardo) ----

// ---------------------------------------------------------------------------
// MÓDULO: produtos (Eduardo)
// Model mínimo criado pelo Diogo para o estoque (Issue #3). O Eduardo acrescenta
// categoria, preço, limites, imagem e visibilidade em migrations novas.
// O estoque usa só id, code, name e unit.
// ---------------------------------------------------------------------------

model Produto {
  id        String   @id @default(cuid())
  code      String   @unique // sempre maiúsculo
  name      String
  unit      String   @default("un") // un, cx, kit, pct...
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  stockReservations StockReservation[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// MÓDULO: estoque (Diogo)
// Regras K1–K4 em docs/regras-de-negocio.md. Nenhum outro módulo altera estas
// tabelas direto: use src/modules/estoque/service.ts (ou api.ts para solicitações).
// ---------------------------------------------------------------------------

/// Saldo de um produto em um almoxarifado. Uma linha por (almoxarifado, produto).
/// disponível = quantity - reserved. quantity (físico) nunca fica negativo (K3).
model StockBalance {
  baseId    String // almoxarifado (Base.type = ALMOXARIFADO)
  produtoId String
  quantity  Int      @default(0) // saldo físico
  reserved  Int      @default(0) // reservado por solicitações aprovadas
  minimum   Int      @default(0) // estoque mínimo (alerta)
  updatedAt DateTime @updatedAt

  base    Base    @relation(fields: [baseId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@id([baseId, produtoId])
  @@index([produtoId])
}

enum StockMovementType {
  ENTRADA // compra / recebimento (com NF)
  SAIDA // consumo, perda, descarte (com motivo)
  TRANSFERENCIA_SAIDA
  TRANSFERENCIA_ENTRADA
  INVENTARIO // ajuste: define o saldo para a quantidade contada
  RESERVA // aprovação de solicitação: só mexe no reservado
  LIBERACAO // recusa/cancelamento: devolve o reservado
  BAIXA // envio de solicitação: tira do físico e do reservado
}

/// Livro-razão do estoque: toda mudança de saldo gera uma linha. Nunca editado nem apagado.
model StockMovement {
  id            String            @id @default(cuid())
  type          StockMovementType
  baseId        String
  produtoId     String
  quantity      Int // variação do saldo FÍSICO (+ entra, - sai, 0 em reserva/liberação)
  reservedDelta Int               @default(0) // variação do reservado
  balanceAfter  Int // físico depois do movimento
  reservedAfter Int // reservado depois do movimento
  document      String? // nº da NF ou documento
  reason        String? // motivo (obrigatório em saída e inventário)
  /// Agrupa os itens de um mesmo lançamento (ex.: uma NF com 10 produtos, uma transferência).
  batchId       String
  /// Origem/contraparte: "solicitacao" + id da solicitação, ou "transferencia" + id do OUTRO almoxarifado
  /// (de onde veio ou para onde foi). O lançamento inteiro é agrupado por batchId.
  refType       String?
  refId         String?
  actorId       String?
  createdAt     DateTime          @default(now())

  base    Base    @relation(fields: [baseId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([baseId, createdAt])
  @@index([produtoId, createdAt])
  @@index([batchId])
  @@index([refType, refId])
  @@index([createdAt])
}

enum StockReservationStatus {
  ATIVA
  BAIXADA // enviada (total ou parcial; o resto foi liberado)
  LIBERADA // recusada/cancelada
}

/// Reserva de uma solicitação aprovada, por produto.
model StockReservation {
  id        String                 @id @default(cuid())
  refType   String                 @default("solicitacao")
  refId     String // id da solicitação (sem FK: o model é do módulo de solicitações)
  baseId    String
  produtoId String
  quantity  Int // reservado
  shipped   Int                    @default(0) // quanto foi baixado no envio
  status    StockReservationStatus @default(ATIVA)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  base    Base    @relation(fields: [baseId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([refType, refId, baseId, produtoId])
  @@index([baseId, produtoId, status])
}
