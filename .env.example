# =============================================================================
# JT Portal ADM — variáveis de ambiente
# Copie para .env (desenvolvimento) ou cadastre no painel do Netlify (produção).
# NUNCA commite o .env com valores reais.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Desenvolvimento local: rode `npm run db:dev` e use a URL TCP que ele mostrar, ex.:
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Produção (Supabase): Project Settings → Database → Connection string.
#   DATABASE_URL = "Transaction pooler" (porta 6543), usado pelo app.
#   DIRECT_URL   = conexão direta (porta 5432), usada só pelas migrations.
# Schema onde ficam as tabelas (vazio = public). Útil para dividir um banco com outro sistema.
# DATABASE_SCHEMA="portal"
# Conexões por instância do app (o padrão 3 basta em serverless).
# DATABASE_POOL_MAX=3

# --- Aplicação ----------------------------------------------------------------
APP_URL="http://localhost:3000"

# Senha dos usuários de exemplo criados pelo seed (só desenvolvimento).
# SEED_PASSWORD="portal123"

# --- Agendador (lembretes, resumo diário, reenvio do Feishu, limpezas) ---------
# Usado pela Netlify Scheduled Function (netlify/functions/agendador.mts) para chamar /api/cron/run.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="troque-por-um-valor-aleatorio-com-32-caracteres"

# --- Feishu (avisos) -------------------------------------------------------------
# Sem nada configurado, o sino do portal funciona normalmente; só não sai nada no Feishu.
# Domínio da Open Platform: Feishu (China) = https://open.feishu.cn | Lark = https://open.larksuite.com
FEISHU_BASE_URL="https://open.feishu.cn"
# Avisos da EQUIPE (aprovação, separação, lembretes, resumo). Escolha UM jeito:
# a) Grupo via app bot (recomendado): adicione o bot do app ao grupo e informe o chat_id (oc_...).
FEISHU_STAFF_CHAT_ID=""
# b) Webhook de bot personalizado do grupo (não precisa do app). Assinatura opcional, se ativada no bot.
FEISHU_WEBHOOK_URL=""
FEISHU_WEBHOOK_SECRET=""
# c) Nenhum dos dois, com o app configurado: mensagem direta para cada pessoa com o open_id no cadastro.
# Grupo da EXPEDIÇÃO (opcional): recebe "pronto para envio" e lembretes de separados parados.
FEISHU_SHIPPING_WEBHOOK_URL=""
FEISHU_SHIPPING_WEBHOOK_SECRET=""
# App da Open Platform: mensagens diretas e grupos das bases (Base → "Grupo do Feishu").
# Pode ser o mesmo app do sistema antigo de insumos (Solicitação de Insumos).
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
