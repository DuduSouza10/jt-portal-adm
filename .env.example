# =============================================================================
# JT Portal ADM — variáveis de ambiente
# Copie para .env (desenvolvimento) ou cadastre no painel da hospedagem (produção; ainda a definir, ver docs/hospedagem.md).
# NUNCA commite o .env com valores reais.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Desenvolvimento local: rode `npm run db:dev` e use a URL TCP que ele mostrar, ex.:
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Produção (Supabase): Project Settings → Database → Connection string.
#   DATABASE_URL = "Transaction pooler" (porta 6543), usado pelo app.
#   DIRECT_URL   = conexão direta (porta 5432), usada só pelas migrations.
# Schema onde ficam as tabelas (vazio = public). Útil para dividir um banco com outro sistema.
# DATABASE_SCHEMA="portal"
# Conexões por instância do app (o padrão 3 basta em serverless).
# DATABASE_POOL_MAX=3

# --- Aplicação ----------------------------------------------------------------
APP_URL="http://localhost:3000"

# Senha dos usuários de exemplo criados pelo seed (só desenvolvimento).
# SEED_PASSWORD="portal123"

# --- Agendador (lembretes, resumo diário, reenvio do Feishu, limpezas) ---------
# Usado pelo agendador que chama /api/cron/run (Netlify, Vercel Cron ou externo: ver docs/hospedagem.md).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="troque-por-um-valor-aleatorio-com-32-caracteres"

# --- IP do cliente (limite de tentativas de login) --------------------------------
# Netlify e Vercel são detectados sozinhos. Em outra hospedagem, informe o cabeçalho que ELA preenche
# com o IP real (o cliente não pode conseguir forjar). Sem isso, o limite por IP fica desligado.
# TRUSTED_IP_HEADER="cf-connecting-ip"

# --- Feishu (avisos) -------------------------------------------------------------
# Sem nada configurado, o sino do portal funciona normalmente; só não sai nada no Feishu.
# Domínio da Open Platform: Feishu (China) = https://open.feishu.cn | Lark = https://open.larksuite.com
FEISHU_BASE_URL="https://open.feishu.cn"

# App/BOT da J&T que manda as mensagens (grupos e mensagem direta). É OUTRO app, diferente do app do login abaixo.
# No app: ative o recurso Bot e as permissões im:message:send_as_bot e im:message:update (editar o cartão a cada
# status). Adicione o bot a cada grupo. Webhooks de grupo NÃO são mais usados.
FEISHU_BOT_APP_ID=""
FEISHU_BOT_APP_SECRET=""
# Grupo GERAL (fallback): usado quando a regional não tem o grupo cadastrado. chat_id (oc_...) com o bot dentro.
FEISHU_STAFF_CHAT_ID=""
# Grupos por regional (SP, MG...): cadastre o chat_id (oc_...) de INSUMOS e de EXPEDIÇÃO na tela da regional
# (Estrutura → Regional). São 4 grupos diferentes com o mesmo bot; insumos e expedição nunca se misturam.
# Grupo da base (Base → "Grupo do Feishu"): chat_id (oc_...) com o bot dentro.
# Mensagem direta: usa o open_id do cadastro do usuário (do app do login) e o union_id dele; o app do login precisa
# da permissão de ler contatos.

# App do LOGIN ("Entrar com Feishu") e do organograma. Não manda mensagens.
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""

# --- Primeiro acesso pelo deploy (opcional, só para criar o PRIMEIRO usuário Dev) -------
# Se FIRST_ADMIN_PASSWORD existir, o build aplica as migrations, cria os tipos de acesso padrão e cria
# este usuário Dev SE ele ainda não existir (nunca altera um usuário existente). A senha é provisória:
# o portal exige trocá-la no primeiro acesso. Cadastre só no painel da hospedagem e apague depois de entrar.
# FIRST_ADMIN_LOGIN="dudu"
# FIRST_ADMIN_NAME="Nome Completo"
# FIRST_ADMIN_PASSWORD="(mínimo 10 caracteres)"
