# =============================================================================
# JT Portal ADM — variáveis de ambiente
# Copie para .env (desenvolvimento) ou cadastre no painel do Netlify (produção).
# NUNCA commite o .env com valores reais.
# =============================================================================

# --- Banco de dados (PostgreSQL) ---------------------------------------------
# Desenvolvimento local: rode `npm run db:dev` e use a URL TCP que ele mostrar, ex.:
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Produção (Supabase): Project Settings → Database → Connection string.
#   DATABASE_URL = "Transaction pooler" (porta 6543), usado pelo app.
#   DIRECT_URL   = conexão direta (porta 5432), usada só pelas migrations.
# Schema onde ficam as tabelas (vazio = public). Útil para dividir um banco com outro sistema.
# DATABASE_SCHEMA="portal"
# Conexões por instância do app (o padrão 3 basta em serverless).
# DATABASE_POOL_MAX=3

# --- Aplicação ----------------------------------------------------------------
APP_URL="http://localhost:3000"

# Senha dos usuários de exemplo criados pelo seed (só desenvolvimento).
# SEED_PASSWORD="portal123"
