    "@types/three": "^0.187.0",
    "dotenv": "^18.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
